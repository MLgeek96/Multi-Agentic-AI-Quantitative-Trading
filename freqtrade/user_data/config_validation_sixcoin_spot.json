{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "sixcoin-2026-spot-validation",
  "dry_run": true,
  "dry_run_wallet": 10000,
  "initial_state": "stopped",
  "max_open_trades": 6,
  "stake_currency": "USDT",
  "stake_amount": 1666.66666667,
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "USD",
  "timeframe": "1h",
  "dataformat_ohlcv": "feather",
  "trading_mode": "spot",
  "margin_mode": "",
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {
      "options": {"defaultType": "spot"},
      "urls": {"api": {"public": "https://api.binance.com/api/v3"}}
    },
    "ccxt_async_config": {},
    "pair_whitelist": [
      "BTC/USDT",
      "ETH/USDT",
      "SOL/USDT",
      "XRP/USDT",
      "BNB/USDT",
      "DOGE/USDT"
    ],
    "pair_blacklist": [],
    "enable_ws": false
  },
  "pairlists": [{"method": "StaticPairList"}],
  "entry_pricing": {"price_side": "other", "use_order_book": true, "order_book_top": 1},
  "exit_pricing": {"price_side": "other", "use_order_book": true, "order_book_top": 1},
  "unfilledtimeout": {"entry": 10, "exit": 10, "unit": "minutes"},
  "order_types": {
    "entry": "market",
    "exit": "market",
    "emergency_exit": "market",
    "force_entry": "market",
    "force_exit": "market",
    "stoploss": "market",
    "stoploss_on_exchange": false
  }
}
